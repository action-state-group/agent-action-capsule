{
  "name": "@action-state-group/agent-action-capsule",
  "version": "0.1.0",
  "description": "TypeScript reference for Agent Action Capsule format 4",
  "license": "BSD-3-Clause",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "browser": {
        "types": "./dist/core-browser.d.ts",
        "import": "./dist/core-browser.js"
      },
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/emitter-shell.html dist/emitter-shell.html && npm run emitter:iife",
    "prepare": "npm run build",
    "emitter:iife": "esbuild src/browser.ts --bundle --format=iife --global-name=EvidenceGraph --footer:js='globalThis.renderEvidenceGraph = EvidenceGraph.renderEvidenceGraph;' --outfile=dist/evidence-graph.iife.js",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run check:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "cborg": "6.1.2"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "@action-state-group/cll": "github:action-state-group/cll-ts#0ac72b3"
  },
  "peerDependencies": {
    "@action-state-group/cll": "github:action-state-group/cll-ts#0ac72b3"
  },
  "peerDependenciesMeta": {
    "@action-state-group/cll": {
      "optional": true
    }
  }
}
