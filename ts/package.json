{
  "name": "@action-state-group/agent-action-capsule",
  "version": "0.1.0",
  "description": "TypeScript reference for Agent Action Capsule format 4",
  "license": "BSD-3-Clause",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@action-state-group/cll": "github:action-state-group/cll-ts#43382d5",
    "cborg": "6.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
