{
  "draft": "draft-mih-agent-evidence-layer-01",
  "section": "Record/Payload Separation, Retention, and Disclosure, UNDISCLOSED and policy_uri",
  "provenance": "spec-derived",
  "rules": {
    "UNDISCLOSED": "policy_uri is REQUIRED",
    "policy_uri": "a URI (RFC 3986, Section 3), not a relative reference; these cases check only a string that is a scheme, then ':', with no whitespace, not full RFC 3986 syntax",
    "other_states": "policy_uri is OPTIONAL",
    "serialization": "JSON object of the header members these rules read; other header members are left out"
  },
  "reasons": {
    "missing_policy_uri": "retention_state is UNDISCLOSED and the record has no policy_uri",
    "policy_uri_form": "retention_state is UNDISCLOSED and policy_uri is not a URI"
  },
  "count": 12,
  "cases": [
    {
      "id": "pos-undisclosed-https",
      "kind": "positive",
      "description": "UNDISCLOSED with an https policy_uri.",
      "record": {
        "retention_state": "UNDISCLOSED",
        "payload_commitments": [
          "f8ebe09f3eaf2a766bd89e39c38daccd6fb7fc26c0eec26796bff7f229728fba"
        ],
        "policy_uri": "https://example.com/policies/retention"
      },
      "expected": {
        "valid": true
      }
    },
    {
      "id": "pos-undisclosed-urn",
