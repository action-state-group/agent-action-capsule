{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/schemas/judge/sample-manifest-v1.json",
  "title": "Sample Manifest v1",
  "description": "Companion schema for spec/judge-record-family-v1.md section 4. The root schema validates a Sample Manifest record: which cases were selected for evaluation, under which sampling policy, stratified how. epistemic_type is fixed to producer_claim -- the sampler's own statement of what it selected, unverified by the store until an evaluation-report/v1 cites the same case ids.",
  "$ref": "#/$defs/SampleManifest",
  "$defs": {
    "HexDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DigestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_alg", "digest"],
      "properties": {
        "digest_alg": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/HexDigest" }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "digest_alg", "digest", "citation_purpose"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "digest_alg": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/HexDigest" },
        "citation_purpose": { "type": "string", "minLength": 1 }
      }
    },
    "PolicyCitation": {
      "allOf": [
        { "$ref": "#/$defs/Citation" },
        { "properties": { "citation_purpose": { "const": "sampling_policy" } } }
      ]
    },
    "SampleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_version", "record_id", "epistemic_type", "generated_at",
        "policy", "stratification", "cases"
      ],
      "properties": {
        "record_version": { "const": "sample-manifest/v1" },
        "record_id": { "type": "string", "minLength": 1 },
        "epistemic_type": { "const": "producer_claim" },
        "generated_at": { "type": "string", "format": "date-time" },
        "policy": { "$ref": "#/$defs/PolicyCitation" },
        "stratification": {
          "description": "Case count by stratum, e.g. {\"held_out\": 40, \"regression\": 10}. Open keys -- strata are policy-defined, not a closed vocabulary this schema owns.",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
