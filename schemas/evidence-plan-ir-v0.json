{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/schemas/evidence-plan-ir-v0.json",
  "title": "Evidence Plan IR v0",
  "description": "Companion schema for spec/evidence-plan-ir-v0.md. The root schema validates an Evidence Plan document. $defs/PlanResult and $defs/AttestationRecord validate the two other document shapes this IR defines, each via a direct $ref to that $def.",
  "$ref": "#/$defs/EvidencePlan",
  "$defs": {
    "HexDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DigestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest_alg", "digest"],
      "properties": {
        "digest_alg": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/HexDigest" }
      }
    },
    "InputRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "digest_alg", "digest"],
          "properties": {
            "by": { "const": "digest" },
            "digest_alg": { "const": "SHA-256" },
            "digest": { "$ref": "#/$defs/HexDigest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "node_id"],
          "properties": {
            "by": { "const": "node" },
            "node_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "Family": {
      "enum": ["traditional", "semantic", "evidence", "assurance", "decision"]
    },
    "Classification": {
      "enum": ["LOCAL_ONLY", "ABSTRACTABLE", "CLOUD_SAFE", "PUBLIC"]
    },
    "Tier": {
      "enum": ["recomputed", "judged"]
    },
    "Operator": {
      "description": "The closed v0 operator catalogue (spec §5). family/tier per operator are fixed by PlanNode's if/then blocks below, not re-listed here.",
      "enum": [
        "traditional.fold_replay",
        "semantic.judge_adjudicate",
        "evidence.request_answer",
        "assurance.verify",
        "assurance.bundle",
        "decision.resolve_verdict"
      ]
    },
    "ContractRef": {
      "description": "Compact versioned Evidence Contract reference: <contract_id>@<version>.",
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "PlanHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_ref", "ir_version", "planner_id", "created_at", "replay_seed"],
      "properties": {
        "contract_ref": { "$ref": "#/$defs/ContractRef" },
        "ir_version": { "const": "evidence-plan-ir-v0" },
        "planner_id": {
          "type": "string",
          "pattern": "^(local|remote):[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "replay_seed": { "type": "string", "minLength": 1 }
      }
    },
    "PlanNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "family", "operator", "inputs", "classification", "tier",
        "contract_ref", "requirement_ref"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/Family" },
        "operator": { "$ref": "#/$defs/Operator" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/InputRef" }
        },
        "classification": { "$ref": "#/$defs/Classification" },
        "tier": { "$ref": "#/$defs/Tier" },
        "contract_ref": { "$ref": "#/$defs/ContractRef" },
        "requirement_ref": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "traditional.fold_replay" } } },
          "then": {
            "properties": {
              "family": { "const": "traditional" },
              "tier": { "const": "recomputed" }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "const": "semantic.judge_adjudicate" } } },
          "then": {
            "properties": {
              "family": { "const": "semantic" },
              "tier": { "const": "judged" }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "const": "evidence.request_answer" } } },
          "then": {
            "properties": {
              "family": { "const": "evidence" },
              "tier": { "const": "recomputed" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": { "enum": ["assurance.verify", "assurance.bundle"] }
            }
          },
          "then": {
            "properties": {
              "family": { "const": "assurance" },
              "tier": { "const": "recomputed" }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "const": "decision.resolve_verdict" } } },
          "then": {
            "properties": {
              "family": { "const": "decision" },
              "tier": { "const": "recomputed" }
            }
          }
        }
      ]
    },
    "EvidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "nodes"],
      "properties": {
        "header": { "$ref": "#/$defs/PlanHeader" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PlanNode" }
        }
      },
      "if": {
        "properties": {
          "header": {
            "properties": {
              "planner_id": { "not": { "pattern": "^local:" } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "classification": { "not": { "const": "LOCAL_ONLY" } }
              }
            }
          }
        }
      }
    },
    "Verdict": {
      "description": "The closed three-value decision-family verdict from decision.resolve_verdict (spec §5). Surfaced on the envelope so a Result emitter does not have to dereference an output digest to read it.",
      "enum": ["met", "not_met", "not_evaluable"]
    },
    "ResultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "status", "outputs", "attestation_ref"],
      "properties": {
        "family": { "$ref": "#/$defs/Family" },
        "status": {
          "enum": [
            "SATISFIED", "INSUFFICIENT", "NOT_FOUND", "NOT_COMMITTED",
            "WITHHELD", "CONTRADICTED", "NOT_APPLICABLE", "UNKNOWN"
          ]
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/DigestRef" }
        },
        "attestation_ref": { "$ref": "#/$defs/DigestRef" },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "if": { "properties": { "family": { "const": "decision" } }, "required": ["family"] },
      "then": { "required": ["verdict"] }
    },
    "PlanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ref", "results"],
      "properties": {
        "plan_ref": { "$ref": "#/$defs/DigestRef" },
        "results": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/ResultEnvelope" }
        }
      }
    },
    "Adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 }
      },
      "dependentRequired": {
        "model": ["model_version"],
        "model_version": ["model"]
      }
    },
    "CodeDigest": {
      "description": "Mirrored from evidence-result-v0.json's CodeDigest, never redefined: a git commit or tree id (40 lowercase hex in a SHA-1 repository, 64 in a SHA-256 one) or the explicit {alg: unknown, value: unknown}. Never a version string.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "value"],
          "properties": {
            "alg": { "enum": ["git-commit", "git-tree"] },
            "value": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "value"],
          "properties": {
            "alg": { "const": "unknown" },
            "value": { "const": "unknown" }
          }
        }
      ]
    },
    "CodeIdentityGrade": {
      "description": "Mirrored from evidence-result-v0.json's Grade (the three-value vocabulary defined in draft-mih-agent-evidence-layer-00's Terminology), never redefined. Used here only for Implementation.grade.",
      "enum": ["self-attested", "witnessed", "countersigned"]
    },
    "Implementation": {
      "description": "Mirrored from evidence-result-v0.json's Implementation, never redefined; that definition's description governs, including its limits: a self-attested commit or tree digest is a claim by whoever built or ran the code and gives comparability only; a witnessed or countersigned build identity gives checkability. An unknown code_digest carries grade self-attested and nothing higher.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code_digest", "grade", "captured_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code_digest": { "$ref": "#/$defs/CodeDigest" },
        "grade": { "$ref": "#/$defs/CodeIdentityGrade" },
        "captured_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "description": "An unknown code identity claims nothing above self-attested.",
          "if": { "properties": { "code_digest": { "properties": { "alg": { "const": "unknown" } }, "required": ["alg"] } }, "required": ["code_digest"] },
          "then": { "properties": { "grade": { "const": "self-attested" } } }
        }
      ]
    },
    "AttestationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicator", "operator", "inputs", "policy_digest", "contract_ref"],
      "properties": {
        "adjudicator": { "$ref": "#/$defs/Adjudicator" },
        "operator": { "$ref": "#/$defs/Operator" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/DigestRef" }
        },
        "policy_digest": {
          "description": "The digest of the policy / prompt / manifest / configuration the operator ran under (spec section 6). A CONFIGURATION digest, not a code digest: a source change with no configuration change is invisible to it. Code identity is the separate `implementation` field; the two are never collapsed into one field, and one value is never used for both (spec section 6).",
          "$ref": "#/$defs/DigestRef"
        },
        "implementation": {
          "description": "Code identity of the executor that produced this record: the same shape, rules and limits as evidence-result-v0.json's Implementation, mirrored here, never redefined (see that definition's description, which governs). OPTIONAL in v0 on every operator. Never the same value as policy_digest: `code_digest.value` MUST differ from `policy_digest.digest` (checker-enforced, since JSON Schema cannot compare sibling values; a 64-hex git-tree id and a SHA-256 configuration digest have the same shape, so reuse is otherwise invisible). A self-attested commit or tree digest is a claim by whoever built or ran the code, not something a stranger verifies from this record: it makes code identity comparable, not checkable; only a witnessed or countersigned build identity is checkable.",
          "$ref": "#/$defs/Implementation"
        },
        "contract_ref": { "$ref": "#/$defs/ContractRef" }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "semantic.judge_adjudicate" } } },
          "then": { "properties": { "adjudicator": { "required": ["model", "model_version"] } } },
          "else": {
            "properties": {
              "adjudicator": {
                "not": { "anyOf": [{ "required": ["model"] }, { "required": ["model_version"] }] }
              }
            }
          }
        }
      ]
    }
  }
}
